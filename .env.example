# Configuración de la Aplicación
APP_NAME="Sistema de Gestión de Eventos"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# Configuración de MongoDB
# Para desarrollo local: mongodb://localhost:27017
# Para producción en Vercel (MongoDB Atlas): mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="gestion_eventos_db"
MONGODB_COLLECTION="eventos"
